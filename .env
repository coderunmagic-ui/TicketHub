APP_NAME=TicketHub
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Taipei
APP_LOCALE=zh_TW
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_TW
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=30
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tickethub
DB_USERNAME=tickethub
DB_PASSWORD=replace_with_your_password
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=redis
QUEUE_CONNECTION=redis
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME=TicketHub
TICKET_HOLD_MINUTES=10
MOCK_PAYMENT_ENABLED=false
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

REDIS_PREFIX=tickethub_v2_
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_ADMISSION_DB=2
REDIS_QUEUE_RETRY_AFTER=120
ADMISSION_ENABLED=true
ADMISSION_NAMESPACE=tickethub-v2
ADMISSION_SLOTS=30
ADMISSION_RATE=10
ADMISSION_BURST=10
ADMISSION_PERMIT_SECONDS=90
ADMISSION_PROCESSING_SECONDS=60
ADMISSION_HEARTBEAT_SECONDS=90
ADMISSION_MAX_WAITERS=50000
CATALOG_CACHE_ENABLED=true
CATALOG_CACHE_SECONDS=5
